{
  "editor.rulers": [80],
  "editor.formatOnSave": true,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[go]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go"
  },
  "go.useLanguageServer": false,
  "go.buildOnSave": "off",
  "go.vetOnSave": "off",
  "go.lintOnSave": "off",
  "files.exclude": {
    "**/plz-out": true,
    "**/.please": true
  },
  "search.exclude": {
    "**/plz-out": true,
    "**/.please": true
  }
}
