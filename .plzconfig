; Please config file
[please]
version = >=17.0.0

[Plugin "go"]
Target = //plugins:go
ImportPath = ""
GoTool = //third_party/go:toolchain|go
Stdlib = //third_party/go:std

[Plugin "kotlin"]
Target = //plugins:kotlin
KotlincTool = //test/kotlin/toolchain:toolchain|kotlinc
JavaTool = //test/kotlin/toolchain:toolchain|java
JacocoAgent = //test/kotlin/toolchain:toolchain|jacoco-agent
JacocoCli = //test/kotlin/toolchain:toolchain|jacoco-cli
JvmTarget = 21

[PluginDefinition]
Name = kotlin

[PluginConfig "please_kotlin_tool"]
ConfigKey = PleaseKotlinTool
DefaultValue = //tools:please_kotlin
Help = A path or build label for the please_kotlin tool
Inherit = true

[PluginConfig "kotlinc_tool"]
ConfigKey = KotlincTool
DefaultValue = kotlinc
Help = Path to the kotlinc compiler to use
Inherit = true

[PluginConfig "java_tool"]
ConfigKey = JavaTool
DefaultValue = java
Help = Path to the java binary to use
Inherit = true

[PluginConfig "jvm_target"]
ConfigKey = JvmTarget
DefaultValue = 21
Help = Default JVM target bytecode version
Inherit = true

[PluginConfig "coverage"]
ConfigKey = Coverage
DefaultValue = true
Help = Whether to instrument Kotlin test targets with coverage
Inherit = true

[PluginConfig "jacoco_agent"]
ConfigKey = JacocoAgent
DefaultValue = 
Help = Path or build label for jacocoagent.jar
Inherit = true

[PluginConfig "jacoco_cli"]
ConfigKey = JacocoCli
DefaultValue = 
Help = Path or build label for jacococli.jar
Inherit = true

[cover]
fileextension = .kt
