; Please config file
[please]
version = >=17.0.0

[Plugin "go"]
Target = //plugins:go
ImportPath = ""
GoTool = //third_party/go:toolchain|go
Stdlib = //third_party/go:std

[Plugin "rust"]
Target = //plugins:rust
PleaseRustTool = //tools/please_rust:please_rust
RustcTool = //tools/rust_toolchain:toolchain|rustc
LlvmProfdataTool = //tools/rust_toolchain:toolchain|llvm-profdata
LlvmCovTool = //tools/rust_toolchain:toolchain|llvm-cov


[PluginDefinition]
Name = rust

[PluginConfig "please_rust_tool"]
ConfigKey = PleaseRustTool
DefaultValue = //tools:please_rust
Help = A path or build label for the please_rust tool
Inherit = true

[PluginConfig "rustc_tool"]
ConfigKey = RustcTool
DefaultValue = rustc
Help = Path to the rustc compiler to use
Inherit = true


[PluginConfig "default_edition"]
ConfigKey = DefaultEdition
DefaultValue = 2021
Help = Default Rust edition (2021, 2024, etc.)
Inherit = true

[PluginConfig "coverage"]
ConfigKey = Coverage
DefaultValue = true
Help = Whether to compile Rust targets with coverage instrumentation
Inherit = true

[PluginConfig "llvm_profdata_tool"]
ConfigKey = LlvmProfdataTool
DefaultValue = 
Help = Path or build label for llvm-profdata
Inherit = true

[PluginConfig "llvm_cov_tool"]
ConfigKey = LlvmCovTool
DefaultValue = 
Help = Path or build label for llvm-cov
Inherit = true

[cover]
fileextension = .rs



