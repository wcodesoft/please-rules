; Please config file
[please]
version = >=17.0.0

[Plugin "go"]
Target = //plugins:go
ImportPath = ""
GoTool = //third_party/go:toolchain|go
Stdlib = //third_party/go:std

[Plugin "ts"]
Target = //plugins:ts
PleaseTsTool = //tools/please_ts:please_ts
DenoTool = //tools/ts_toolchain:toolchain|deno
BrowserTool = //tools/browser_toolchain:toolchain|chromium

[PluginDefinition]
Name = ts

[PluginConfig "please_ts_tool"]
ConfigKey = PleaseTsTool
DefaultValue = //tools:please_ts
Help = A path or build label for the please_ts tool
Inherit = true

[PluginConfig "deno_tool"]
ConfigKey = DenoTool
DefaultValue = deno
Help = Path to the deno binary or toolchain target to use
Inherit = true

[PluginConfig "browser_tool"]
ConfigKey = BrowserTool
DefaultValue = //tools/browser_toolchain:toolchain|chromium
Help = Path to the hermetic browser binary or toolchain target to use
Inherit = true

[PluginConfig "coverage"]
ConfigKey = Coverage
DefaultValue = true
Help = Whether to collect coverage during test execution
Inherit = true

[PluginConfig "module_prefix"]
ConfigKey = ModulePrefix
DefaultValue = ""
Help = Default module prefix used to automatically derive module_name for TypeScript targets (e.g. @repo or @veritas)
Inherit = true


