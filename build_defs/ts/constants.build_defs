# The esbuild that `deno bundle` runs, as the npm package that carries its binary. Deno looks for
# it under DENO_DIR/dl/esbuild-<version> and downloads its own otherwise: the version here must be
# the one the default Deno version (above) uses, and tools/please_ts/bundle/denobundle.go maps
# the Deno version to the directory name.
DEFAULT_ESBUILD_VERSION = "0.25.5"

