        "strip_prefix": f"swift-{DEFAULT_SWIFT_VERSION}-RELEASE-ubuntu22.04/usr",
    },
    "linux_arm64": {
        "url": f"https://download.swift.org/swift-{DEFAULT_SWIFT_VERSION}-release/ubuntu2204-aarch64/swift-{DEFAULT_SWIFT_VERSION}-RELEASE/swift-{DEFAULT_SWIFT_VERSION}-RELEASE-ubuntu22.04-aarch64.tar.gz",
        "hash": "",
        "strip_prefix": f"swift-{DEFAULT_SWIFT_VERSION}-RELEASE-ubuntu22.04-aarch64/usr",
