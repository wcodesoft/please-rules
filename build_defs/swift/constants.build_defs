"""
Default constants and platform configurations for Swift toolchains.
"""

DEFAULT_SWIFT_VERSION = "6.3.3"
DEFAULT_SWIFT_TOOLCHAIN_RELEASE_VERSION = "6.3.3"

# Minimal Swift toolchain release distributions hosted on GitHub Releases.
# These stripped bundles (~150-180MB) exclude LLDB, SPM, DocC, and SourceKit-LSP.
SWIFT_MINIMAL_PLATFORM_MAP = {
    "linux_amd64": {
        "url": f"https://github.com/wcodesoft/please-rules/releases/download/swift-toolchain-v{DEFAULT_SWIFT_TOOLCHAIN_RELEASE_VERSION}/swift-{DEFAULT_SWIFT_TOOLCHAIN_RELEASE_VERSION}-minimal-linux_amd64.tar.gz",
        "hash": "5d886b4b389f94b8e3fdb2fe0c5b233528df888628ce1c53745649dd6ee7d0df",
        "strip_prefix": "",
    },
    "linux_arm64": {
        "url": f"https://github.com/wcodesoft/please-rules/releases/download/swift-toolchain-v{DEFAULT_SWIFT_TOOLCHAIN_RELEASE_VERSION}/swift-{DEFAULT_SWIFT_TOOLCHAIN_RELEASE_VERSION}-minimal-linux_arm64.tar.gz",
        "hash": "",
        "strip_prefix": "",
    },
}

# Official upstream monolithic toolchains as fallback
SWIFT_OFFICIAL_PLATFORM_MAP = {
    "linux_amd64": {
        "url": f"https://download.swift.org/swift-{DEFAULT_SWIFT_VERSION}-release/ubuntu2204/swift-{DEFAULT_SWIFT_VERSION}-RELEASE/swift-{DEFAULT_SWIFT_VERSION}-RELEASE-ubuntu22.04.tar.gz",
