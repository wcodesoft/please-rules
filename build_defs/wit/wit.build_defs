def python_wit_bindgen(
    name: str,
    wit: str,
    package: str = "",
    worlds: list = None,
    flags: list = None,
    visibility: list = None,
):
    """Generates Python type stubs and bindings from a wit_library."""
    base_name = _clean_wit_name(wit)
    return _wit_bindgen(
        name = name,
        wit = wit,
        language = "python",
        package = package or base_name,
        worlds = worlds,
        flags = flags,
        visibility = visibility,
    )

# Alias for python_wit_bindgen
py_wit_bindgen = python_wit_bindgen
