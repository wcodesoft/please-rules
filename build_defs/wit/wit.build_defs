"""Please build definitions for WebAssembly Interface Types (WIT) and code generation."""

subinclude("//build_defs/wit:constants")

def _please_wit_tool(tools):
    tool = CONFIG.WIT.PLEASE_WIT_TOOL
    if tool and (tool.startswith("//") or tool.startswith("///") or tool.startswith(":")):
        tools["PLEASE_WIT"] = [tool]
        return '"$TOOLS_PLEASE_WIT"'
    elif tool:
        return f'"{tool}"'
    return "please_wit"

def wit_library(
    name: str,
    srcs: list,
    package: str = "",
    deps: list = None,
    visibility: list = None,
    labels: list = None,
):
    """Collects and packages .wit interface definitions into a WIT package."""
    all_labels = ["wit", "wit_library"] + (labels or [])
    tools = {}
    please_wit_cmd = _please_wit_tool(tools)
    cmd = f'{please_wit_cmd} package --out "$OUT" --srcs "$SRCS"'

    return build_rule(
        name = name,
        srcs = srcs,
        deps = deps or [],
        outs = [name],
        cmd = cmd,
        tools = tools,
        labels = all_labels,
        visibility = visibility or ["PUBLIC"],
    )

def _clean_wit_name(wit: str) -> str:
    target = wit.split(":")[-1]
    if target.endswith("_wit"):
        return target[:-4]
    return target

def _to_pascal_case(s: str) -> str:
    parts = s.replace("-", "_").split("_")
    return "".join([p[0].upper() + p[1:] if len(p) > 1 else p.upper() for p in parts if p])

def _wit_bindgen(
    name: str,
    wit: str,
    language: str,
    worlds: list = None,
    flags: list = None,
    package: str = "",
    filename: str = "",
    module_name: str = "",
    visibility: list = None,
    labels: list = None,
):
    """Private core rule: generates language bindings from a wit_library."""
    tools = {}
    please_wit_cmd = _please_wit_tool(tools)

    selected_worlds = worlds or []
    extra_flags = " ".join(flags or [])

    args = [
        please_wit_cmd,
        "generate",
        "--lang", language,
        "--out", '"$OUT"',
        "--srcs", '"$SRCS"',
    ]
    if selected_worlds:
        worlds_arg = ",".join(selected_worlds)
        args.extend(["--worlds", f'"{worlds_arg}"'])
    if package:
        args.extend(["--package", f'"{package}"'])
    if filename:
        args.extend(["--companion-filename", f'"{filename}"'])
    if module_name:
        args.extend(["--module-name", f'"{module_name}"'])
    if extra_flags:
        args.extend(["--flags", f'"{extra_flags}"'])

    cmd = " ".join(args)
    all_labels = ["wit", f"wit_{language}", language] + (labels or [])

    return build_rule(
        name = name,
        srcs = [wit],
        outs = [name],
        cmd = cmd,
        tools = tools,
        labels = all_labels,
        visibility = visibility or ["PUBLIC"],
    )

def swift_wit_bindgen(
    name: str,
    wit: str,
    filename: str = "",
    module_name: str = "",
    package: str = "",
    worlds: list = None,
    flags: list = None,
    visibility: list = None,
):
    """Generates Swift protocols and bindings from a wit_library."""
    base_name = _clean_wit_name(wit)
    pascal_name = _to_pascal_case(base_name)
    return _wit_bindgen(
        name = name,
        wit = wit,
        language = "swift",
        filename = filename or f"{pascal_name}.swift",
        module_name = module_name or pascal_name,
        package = package,
        worlds = worlds,
        flags = flags,
        visibility = visibility,
    )

def kt_wit_bindgen(
    name: str,
    wit: str,
    filename: str = "",
    package: str = "",
    worlds: list = None,
    flags: list = None,
    visibility: list = None,
):
    """Generates Kotlin interfaces and WASI bindings from a wit_library."""
    base_name = _clean_wit_name(wit)
    pascal_name = _to_pascal_case(base_name)
    return _wit_bindgen(
        name = name,
        wit = wit,
        language = "kotlin",
        filename = filename or f"{pascal_name}.kt",
        package = package,
        worlds = worlds,
        flags = flags,
        visibility = visibility,
    )

def rust_wit_bindgen(
    name: str,
    wit: str,
    worlds: list = None,
    flags: list = None,
    visibility: list = None,
):
    """Generates Rust Guest traits and bindings from a wit_library."""
    return _wit_bindgen(
        name = name,
        wit = wit,
        language = "rust",
        worlds = worlds,
        flags = flags,
        visibility = visibility,
    )

