"""Please build definitions for WebAssembly Interface Types (WIT) and code generation."""

subinclude("//build_defs/wit:constants")

def _wit_bindgen_tool(tools):
    tool = CONFIG.WIT.WIT_BINDGEN_TOOL
    if tool and (tool.startswith("//") or tool.startswith("///") or tool.startswith(":")):
        tools["WIT_BINDGEN"] = [tool]
        return '"$TOOLS_WIT_BINDGEN"'
    elif tool:
        return f'"{tool}"'
    return "wit-bindgen"

def _wasm_tools_tool(tools):
    tool = CONFIG.WIT.WASM_TOOLS_TOOL
    if tool and (tool.startswith("//") or tool.startswith("///") or tool.startswith(":")):
        tools["WASM_TOOLS"] = [tool]
        return '"$TOOLS_WASM_TOOLS"'
    elif tool:
        return f'"{tool}"'
    return "wasm-tools"

def _please_wit_tool(tools):
    tool = CONFIG.WIT.PLEASE_WIT_TOOL
    if tool and (tool.startswith("//") or tool.startswith("///") or tool.startswith(":")):
        tools["PLEASE_WIT"] = [tool]
        return '"$TOOLS_PLEASE_WIT"'
    elif tool:
        return f'"{tool}"'
    return "please_wit"

def wit_toolchain(
    name: str = "toolchain",
    bindgen_version: str = DEFAULT_WIT_BINDGEN_VERSION,
    wasm_tools_version: str = DEFAULT_WASM_TOOLS_VERSION,
    target_platform: str = "",
    visibility: list = None,
):
    """Assembles a 100% hermetic wit-bindgen and wasm-tools toolchain."""
    plat = target_platform or f"{CONFIG.OS}_{CONFIG.ARCH}"
    bindgen_info = WIT_BINDGEN_PLATFORM_MAP.get(plat, WIT_BINDGEN_PLATFORM_MAP.get("linux_amd64"))
    wasm_info = WASM_TOOLS_PLATFORM_MAP.get(plat, WASM_TOOLS_PLATFORM_MAP.get("linux_amd64"))

    bindgen_dl = f"_{name}_wit_bindgen_dl"
    remote_file(
        name = bindgen_dl,
        url = bindgen_info["url"],
        hashes = [bindgen_info["hash"]] if bindgen_info.get("hash") else [],
    )

    wasm_dl = f"_{name}_wasm_tools_dl"
    remote_file(
        name = wasm_dl,
        url = wasm_info["url"],
        hashes = [wasm_info["hash"]] if wasm_info.get("hash") else [],
    )

    tools = {}
    please_wit_cmd = _please_wit_tool(tools)
    cmd = f'{please_wit_cmd} toolchain --out "$OUT" --wit-bindgen-tar "$SRCS_BINDGEN" --wasm-tools-tar "$SRCS_WASM"'

    return build_rule(
        name = name,
        srcs = {
            "BINDGEN": [f":{bindgen_dl}"],
            "WASM": [f":{wasm_dl}"],
        },
        outs = [name],
        cmd = cmd,
        tools = tools,
        entry_points = {
            "wit-bindgen": f"{name}/bin/wit-bindgen",
            "wasm-tools": f"{name}/bin/wasm-tools",
        },
        binary = True,
        labels = ["toolchain", "wit"],
        visibility = visibility or ["PUBLIC"],
    )

def wit_library(
    name: str,
    srcs: list,
    package: str = "",
    deps: list = None,
    visibility: list = None,
    labels: list = None,
):
    """Collects and packages .wit interface definitions into a WIT package."""
    all_labels = ["wit", "wit_library"] + (labels or [])
    tools = {}
    please_wit_cmd = _please_wit_tool(tools)
    cmd = f'{please_wit_cmd} package --out "$OUT" --srcs "$SRCS"'

    return build_rule(
        name = name,
        srcs = srcs,
        deps = deps or [],
        outs = [name],
        cmd = cmd,
        tools = tools,
        labels = all_labels,
        visibility = visibility or ["PUBLIC"],
    )

def _wit_bindgen(
    name: str,
    wit: str,
    language: str,
    worlds: list = None,
    flags: list = None,
    visibility: list = None,
    labels: list = None,
):
    """Private core rule: generates language bindings from a wit_library."""
    tools = {}
    please_wit_cmd = _please_wit_tool(tools)
    bindgen_tool = _wit_bindgen_tool(tools)

    selected_worlds = worlds or []
    extra_flags = " ".join(flags or [])

    args = [
        please_wit_cmd,
        "generate",
        "--bindgen", bindgen_tool,
        "--lang", language,
        "--out", '"$OUT"',
        "--srcs", '"$SRCS"',
    ]
    if selected_worlds:
        worlds_arg = ",".join(selected_worlds)
        args.extend(["--worlds", f'"{worlds_arg}"'])
    if extra_flags:
        args.extend(["--flags", f'"{extra_flags}"'])

    cmd = " ".join(args)
    all_labels = ["wit", f"wit_{language}", language] + (labels or [])

    return build_rule(
        name = name,
        srcs = [wit],
        outs = [name],
        cmd = cmd,
        tools = tools,
        labels = all_labels,
        visibility = visibility or ["PUBLIC"],
    )

def swift_wit_bindgen(
    name: str,
    wit: str,
    worlds: list = None,
    flags: list = None,
    visibility: list = None,
):
    """Generates Swift protocols and bindings from a wit_library."""
    return _wit_bindgen(
        name = name,
        wit = wit,
        language = "swift",
        worlds = worlds,
        flags = flags,
        visibility = visibility,
    )

def kt_wit_bindgen(
    name: str,
    wit: str,
    worlds: list = None,
    flags: list = None,
    visibility: list = None,
):
    """Generates Kotlin interfaces and WASI bindings from a wit_library."""
    return _wit_bindgen(
