"""
Please build definitions for Rust rules.
"""
subinclude("//build_defs/rust:constants")

def _rust_tool():
    return CONFIG.RUST.PLEASE_RUST_TOOL

def _default_edition():
    return CONFIG.RUST.DEFAULT_EDITION

def _build_tools():
    """Returns (tools_dict, rustc_arg_string) configured for build_rule."""
    tools = {"TOOL": [_rust_tool()]}
    tool = CONFIG.RUST.RUSTC_TOOL
    if tool and tool != "rustc" and (tool.startswith("//") or tool.startswith("///") or tool.startswith(":")):
        tools["RUSTC"] = [tool]
        return tools, '--rustc "$TOOLS_RUSTC"'
    elif tool and tool != "rustc":
        return tools, f"--rustc '{tool}'"
    return tools, ""

def _resolve_main(srcs, main, candidates):
    """Finds the root entrypoint source file among srcs matching candidate order."""
    if main:
        return main
    found = ""
    for cand in candidates:
        if not found and cand in srcs:
            found = cand
    if not found and len(srcs) > 0:
        found = srcs[0]
    return found

def _format_env(env):
    """Formats an env dictionary into shell export lines."""
    if not env:
        return ""
    return "\n".join([f'export {k}="{v}"' for k, v in env.items()]) + "\n"

def _compile_cmd(crate, crate_type, edition, main_src, flags, env, rustc_arg):
    """Formats the please_rust compile shell command."""
    flags_str = " ".join(flags or [])
    env_exports = _format_env(env)
    return f"""
    TOOL="${{TOOLS_TOOL:-$TOOL}}"
    {env_exports}
    $TOOL compile \\
      --crate-name {crate} \\
      --crate-type {crate_type} \\
      --edition {edition} \\
      --out $OUT \\
      --main-src "{main_src}" \\
      --version "${{CARGO_PKG_VERSION:-}}" \\
      --flags "{flags_str}" \\
      {rustc_arg} \\
      ${{SRCS:-}} ${{DEPS:-}}
    """

def _is_coverage_enabled(rule_coverage=None):
    """Determines whether coverage instrumentation is enabled for a target."""
    if rule_coverage is not None:
        return rule_coverage
    return CONFIG.get("RUST.COVERAGE", "true").lower() in ("true", "1", "yes", "on")

def _test_tools(profdata_override=None, cov_override=None):
    """Returns test_tools dictionary for rust_test."""
    tools = {"TOOL": [_rust_tool()]}
    profdata = profdata_override or CONFIG.get("RUST.LLVM_PROFDATA_TOOL", "")
    cov = cov_override or CONFIG.get("RUST.LLVM_COV_TOOL", "")
    if profdata and (profdata.startswith("//") or profdata.startswith("///") or profdata.startswith(":")):
        tools["LLVM_PROFDATA"] = [profdata]
    if cov and (cov.startswith("//") or cov.startswith("///") or cov.startswith(":")):
        tools["LLVM_COV"] = [cov]
    return tools

def rust_library(
        name:str,
        srcs:list=None,
        deps:list=None,
        edition:str=None,
        flags:list=None,
        crate_name:str=None,
        main:str=None,
        visibility:list=None,
        test_only:bool=False,
        labels:list=None,
        env:dict=None,
        coverage:bool=None):
    """
    Compiles a Rust static library (.rlib).
    """
    srcs = srcs or []
    crate = crate_name or name
    resolved_main = _resolve_main(srcs, main, ["src/lib.rs", "lib.rs", "mod.rs", "src/mod.rs"])
    tools, rustc_arg = _build_tools()
    flags = [f for f in (flags or [])]
    if _is_coverage_enabled(coverage) and "-C instrument-coverage" not in " ".join(flags):
        flags.append("-C instrument-coverage")

    cmd = _compile_cmd(
        crate = crate,
        crate_type = "rlib",
        edition = edition or _default_edition(),
        main_src = resolved_main,
        flags = flags,
        env = env,
        rustc_arg = rustc_arg,
    )

    return build_rule(
        name = name,
        srcs = srcs,
        deps = deps or [],
        outs = [f"lib{crate}.rlib"],
        cmd = cmd,
        needs_transitive_deps = True,
        tools = tools,
        visibility = visibility,
        test_only = test_only,
        labels = labels or ["rust"],
        building_description = f"Compiling Rust library {crate}...",
    )

def rust_bin(
        name:str,
        srcs:list=None,
        deps:list=None,
        edition:str=None,
        flags:list=None,
        crate_name:str=None,
        main:str=None,
        visibility:list=None,
        test_only:bool=False,
        labels:list=None,
        env:dict=None,
        coverage:bool=None):
    """
    Compiles a Rust binary executable.
    """
    srcs = srcs or []
    crate = crate_name or name
    resolved_main = _resolve_main(srcs, main, ["src/main.rs", "main.rs"])
    tools, rustc_arg = _build_tools()
    flags = [f for f in (flags or [])]
    if coverage is True and "-C instrument-coverage" not in " ".join(flags):
        flags.append("-C instrument-coverage")

    cmd = _compile_cmd(
        crate = crate,
        crate_type = "bin",
        edition = edition or _default_edition(),
        main_src = resolved_main,
        flags = flags,
        env = env,
        rustc_arg = rustc_arg,
    )

    return build_rule(
        name = name,
        srcs = srcs,
        deps = deps or [],
        outs = [name],
        cmd = cmd,
        binary = True,
        needs_transitive_deps = True,
        tools = tools,
        visibility = visibility,
        test_only = test_only,
        labels = labels or ["rust"],
        building_description = f"Compiling Rust binary {name}...",
    )

def rust_test(
        name:str,
        srcs:list=None,
        deps:list=None,
        edition:str=None,
        flags:list=None,
        crate_name:str=None,
        main:str=None,
        visibility:list=None,
        labels:list=None,
        data:list=None,
        size:str="medium",
        timeout:int=0,
        flaky:bool=False,
        env:dict=None,
        coverage:bool=None,
        llvm_profdata:str=None,
        llvm_cov:str=None):
    """
    Compiles and executes a Rust test suite using Please's test runner.
    """
    srcs = srcs or []
    crate = crate_name or name
    resolved_main = _resolve_main(srcs, main, ["src/lib.rs", "lib.rs", "mod.rs", "src/mod.rs"])
    tools, rustc_arg = _build_tools()
    flags = [f for f in (flags or [])]
    if _is_coverage_enabled(coverage) and "-C instrument-coverage" not in " ".join(flags):
        flags.append("-C instrument-coverage")

    cmd = _compile_cmd(
        crate = crate,
        crate_type = "test",
        edition = edition or _default_edition(),
        main_src = resolved_main,
        flags = flags,
        env = env,
        rustc_arg = rustc_arg,
    )

    profdata_arg = f"--llvm-profdata '{llvm_profdata}'" if llvm_profdata and not (llvm_profdata.startswith("//") or llvm_profdata.startswith("///") or llvm_profdata.startswith(":")) else '${TOOLS_LLVM_PROFDATA:+--llvm-profdata "$TOOLS_LLVM_PROFDATA"}'
    cov_arg = f"--llvm-cov '{llvm_cov}'" if llvm_cov and not (llvm_cov.startswith("//") or llvm_cov.startswith("///") or llvm_cov.startswith(":")) else '${TOOLS_LLVM_COV:+--llvm-cov "$TOOLS_LLVM_COV"}'

    test_cmd = f'TOOL="${{TOOLS_TOOL:-$TOOL}}" && $TOOL test-runner --pkg "{crate}" {profdata_arg} {cov_arg} "$TEST" --nocapture'
    if env:
        test_env_exports = " && ".join([f'export {k}="{v}"' for k, v in env.items()])
        test_cmd = f"{test_env_exports} && {test_cmd}"

    return build_rule(
        name = name,
        srcs = srcs,
        deps = deps or [],
        outs = [name],
        cmd = cmd,
        test_cmd = test_cmd,
        binary = True,
        test = True,
        needs_transitive_deps = True,
        tools = tools,
        test_tools = _test_tools(llvm_profdata, llvm_cov),
        visibility = visibility,
        labels = labels or ["rust"],
        data = data,
        size = size,
        test_timeout = timeout,
        flaky = flaky,
        building_description = f"Compiling Rust test {name}...",
    )

def rust_crate(
        name:str,
        version:str="",
        sha256:str="",
        crate_name:str="",
        features:list=None,
        deps:list=None,
        proc_macro:bool=False,
        meta:bool=False,
        c_srcs:list=None,
        c_hdrs:list=None,
        flags:list=None,
        build_script:bool=False,
        license:str="",
        repository:str="",
        visibility:list=["PUBLIC"]):
    """
    Downloads and compiles a third-party Rust crate hermetially — no cargo.

    Source is fetched from crates.io once (sha256-verified) and cached by Please.
    Each crate is compiled individually with rustc, using explicitly-declared deps.
    Hash consistency is guaranteed by Please's dep graph, not a shared cargo workspace.

    To get the sha256 for a new crate:
      please_rust hash --crate <name> --version <version>

    Args:
      name:         Crate package name as on crates.io (may use hyphens).
      version:      Exact crate version (e.g. "0.26.11").
      sha256:       SHA-256 hex digest of the .crate tarball. Required.
      crate_name:   Rust identifier (underscores). Defaults to name with hyphens replaced.
      features:     Rust feature flags to enable (e.g. ["derive"]).
      deps:         All Rust-level deps; each must produce an rlib or so.
      proc_macro:   True if this is a proc-macro crate (produces .so instead of .rlib).
      meta:         True for virtual targets with no compiled output.
      c_srcs:       C source files inside the crate (relative to crate root).
                    Compiled directly — avoids needing to run build.rs for grammar crates.
      c_hdrs:       C header directories inside the crate (relative to crate root).
      build_script: Reserved. True if build.rs generates code (not yet implemented).
      license:      Informational only.
      repository:   Informational only.
    """
    features = features or []
    deps = deps or []
    c_srcs = c_srcs or []
    c_hdrs = c_hdrs or []
    vis = visibility or ["PUBLIC"]

    if meta:
        return filegroup(
            name = name,
            deps = deps,
            visibility = vis,
            labels = ["rust", "rust_crate", "meta"],
        )

    if not version:
        fail(f"rust_crate '{name}' requires a version")
    if not sha256:
        fail(f"rust_crate '{name}': sha256 is required.\nRun: please_rust hash --crate {name} --version {version}")

    crate = (crate_name or name).replace("-", "_")
    ext = ".so" if proc_macro else ".rlib"
    out_file = f"lib{crate}{ext}"
    features_str = ",".join(features)
    tools, rustc_arg = _build_tools()

    # In the build tmpdir, dep outputs from the same package live under
    # the package path (e.g. "third_party/rust/"). Use that as a prefix
    # when referencing sibling rule outputs by filename.
    pkg = package_name()
    pkg_prefix = f"{pkg}/" if pkg else ""
    tar_name = f"{name}-{version}.tar"

    # ── 1. Download ───────────────────────────────────────────────────────────
    # Fetches the .crate tarball from crates.io, verifies sha256, extracts,
    # adds crate_meta.json (lib_src, edition from Cargo.toml), repacks as plain tar.
    dl = f"_download_{name}"
    build_rule(
        name = dl,
        outs = [tar_name],
        cmd = f"""
$TOOL download \\
  --crate {name} \\
  --version {version} \\
  --sha256 {sha256} \\
  --out "$OUT"
""",
        tools = {"TOOL": [_rust_tool()]},
        labels = ["rust_download"],
        building_description = f"Downloading {name} {version}...",
    )

    all_deps = [f":{dl}"] + deps

    # ── 2. C compilation (optional) ───────────────────────────────────────────
    # Compiles declared C sources into a static lib (.a), replacing build.rs for
    # grammar crates (tree-sitter-go, tree-sitter-rust, etc.).
    native_lib_arg = ""
    if c_srcs:
        cl = f"_c_{name}"
        inc_args = " ".join([f'--include "{name}-{version}/{h}"' for h in c_hdrs])
        src_args = " ".join([f'"{name}-{version}/{s}"' for s in c_srcs])

        build_rule(
            name = cl,
            outs = [f"lib{crate}.a"],
            deps = [f":{dl}"],
            cmd = f"""
tar xf "{pkg_prefix}{tar_name}"
$TOOL compile-c \\
  --out "$OUT" \\
  {inc_args} \\
  {src_args}
""",
            tools = {"TOOL": [_rust_tool()]},
            labels = ["rust_c_compile"],
            building_description = f"Compiling C for {name}...",
        )
        all_deps += [f":{cl}"]
        native_lib_arg = f'--native-lib "{pkg_prefix}lib{crate}.a"'

    # ── 3. Compile Rust ───────────────────────────────────────────────────────
    # Extracts the source tar, then invokes rustc via the compile subcommand.
    # crate_meta.json (written by the download tool) provides lib_src + edition.
    # Dep rlibs are discovered automatically from $DEPS by discoverDepFiles.
    features_flag = f'--features "{features_str}"' if features_str else ""
    flags_str = " ".join(flags or [])
    flags_arg = f'--flags "{flags_str}"' if flags_str else ""
    crate_type = "proc-macro" if proc_macro else "rlib"

    cmd = f"""
TOOL="${{TOOLS_TOOL:-$TOOL}}"
tar xf "{pkg_prefix}{tar_name}"
export OUT_DIR="${{OUT_DIR:-$(pwd)/{name}-{version}/src/wasm}}"
if [ ! -d "$OUT_DIR" ]; then
  export OUT_DIR="$(pwd)/{name}-{version}"
fi
$TOOL compile \\
  --crate-name {crate} \\
  --crate-type {crate_type} \\
  --version {version} \\
  --out "$OUT" \\
  --meta "{name}-{version}/crate_meta.json" \\
  {features_flag} \\
  {flags_arg} \\
  {native_lib_arg} \\
  {rustc_arg} \\
  ${{DEPS:-}}

"""

    return build_rule(
        name = name,
        outs = [out_file],
        deps = all_deps,
        cmd = cmd,
        needs_transitive_deps = True,
        tools = tools,
        visibility = vis,
        labels = ["rust", "rust_crate"],
        building_description = f"Compiling {name} {version}...",
    )

def _default_hash(version, component, triple):
    if version in DEFAULT_HASHES and component in DEFAULT_HASHES[version]:
        return DEFAULT_HASHES[version][component].get(triple, "")
    return ""

def rust_toolchain(
        name:str="toolchain",
        version:str=DEFAULT_RUST_VERSION,
        rustc_url:str="",
        std_url:str="",
        llvm_tools_url:str="",
        rustc_hash:str="",
        std_hash:str="",
        llvm_tools_hash:str="",
        include_llvm_tools:bool=True,
        visibility:list=["PUBLIC"],
        labels:list=None):
    """
    Downloads and provides a hermetic Rust toolchain (rustc, rust-std, and llvm-tools).

    Exposes entry points:
      - :<name>|rustc
      - :<name>|llvm-profdata
      - :<name>|llvm-cov

    To use this toolchain in your project:
      1. Declare in a BUILD file (e.g. build_defs/rust/BUILD):
         rust_toolchain(name = "toolchain", version = "1.85.0")
      2. Configure in .plzconfig:
         [Plugin "rust"]
         Target = //plugins:rust
         RustcTool = //build_defs/rust:toolchain|rustc
         LlvmProfdataTool = //build_defs/rust:toolchain|llvm-profdata
         LlvmCovTool = //build_defs/rust:toolchain|llvm-cov
    """
    host_key = f"{CONFIG.HOSTOS}_{CONFIG.HOSTARCH}"
    target_triple = TRIPLES.get(host_key)
    if not target_triple:
        fail(f"Unsupported host architecture for rust_toolchain: {host_key}")

    dl_rustc_url = rustc_url or f"https://static.rust-lang.org/dist/rustc-{version}-{target_triple}.tar.gz"
    dl_std_url = std_url or f"https://static.rust-lang.org/dist/rust-std-{version}-{target_triple}.tar.gz"

    resolved_rustc_hash = rustc_hash or _default_hash(version, "rustc", target_triple)
    resolved_std_hash = std_hash or _default_hash(version, "std", target_triple)

    dl_rustc_target = f"_{name}_rustc_dl"
    remote_file(
        name = dl_rustc_target,
        url = dl_rustc_url,
        hashes = [resolved_rustc_hash] if resolved_rustc_hash else [],
    )

    dl_std_target = f"_{name}_std_dl"
    remote_file(
        name = dl_std_target,
        url = dl_std_url,
        hashes = [resolved_std_hash] if resolved_std_hash else [],
    )

    srcs = {
        "RUSTC": [f":{dl_rustc_target}"],
        "STD": [f":{dl_std_target}"],
    }

    entry_points = {
        "rustc": f"{name}/bin/rustc",
    }

    llvm_unpack_cmd = ""
    if include_llvm_tools:
        dl_llvm_tools_url = llvm_tools_url or f"https://static.rust-lang.org/dist/llvm-tools-{version}-{target_triple}.tar.gz"
        resolved_llvm_tools_hash = llvm_tools_hash or _default_hash(version, "llvm_tools", target_triple)
        dl_llvm_tools_target = f"_{name}_llvm_tools_dl"
        remote_file(
            name = dl_llvm_tools_target,
            url = dl_llvm_tools_url,
            hashes = [resolved_llvm_tools_hash] if resolved_llvm_tools_hash else [],
        )
        srcs["LLVM_TOOLS"] = [f":{dl_llvm_tools_target}"]
        entry_points["llvm-profdata"] = f"{name}/bin/llvm-profdata"
        entry_points["llvm-cov"] = f"{name}/bin/llvm-cov"
        llvm_unpack_cmd = f"""
if [ -n "${{SRCS_LLVM_TOOLS:-}}" ]; then
  tar -xzf "$SRCS_LLVM_TOOLS" -C "$TMP_DIR"
  cp -R "$TMP_DIR"/llvm-tools-*/llvm-tools-*/lib/rustlib/* "$OUT/lib/rustlib/"
  if [ -f "$OUT/lib/rustlib/{target_triple}/bin/llvm-profdata" ]; then
    ln -sf "../lib/rustlib/{target_triple}/bin/llvm-profdata" "$OUT/bin/llvm-profdata"
    chmod +x "$OUT/lib/rustlib/{target_triple}/bin/llvm-profdata" "$OUT/bin/llvm-profdata"
  fi
  if [ -f "$OUT/lib/rustlib/{target_triple}/bin/llvm-cov" ]; then
    ln -sf "../lib/rustlib/{target_triple}/bin/llvm-cov" "$OUT/bin/llvm-cov"
    chmod +x "$OUT/lib/rustlib/{target_triple}/bin/llvm-cov" "$OUT/bin/llvm-cov"
  fi
fi
"""

    cmd = f"""
mkdir -p "$OUT/bin" "$OUT/lib"
TMP_DIR=$(mktemp -d)
tar -xzf "$SRCS_RUSTC" -C "$TMP_DIR"
cp -R "$TMP_DIR"/rustc-*/rustc/* "$OUT/"
tar -xzf "$SRCS_STD" -C "$TMP_DIR"
cp -R "$TMP_DIR"/rust-std-*/rust-std-*/lib/rustlib "$OUT/lib/"
{llvm_unpack_cmd}
rm -rf "$TMP_DIR"
chmod +x "$OUT/bin/rustc"
"""

    return build_rule(
        name = name,
        srcs = srcs,
        outs = [name],
        cmd = cmd,
        entry_points = entry_points,
        binary = True,
        visibility = visibility,
        labels = labels or ["rust", "toolchain"],
        building_description = f"Assembling hermetic Rust toolchain {version} ({target_triple})...",
    )


