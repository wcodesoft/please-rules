"""
Please build definitions for Rust rules.
"""

_TARGET_TRIPLES = {
    "linux_amd64": "x86_64-unknown-linux-gnu",
    "linux_arm64": "aarch64-unknown-linux-gnu",
    "darwin_amd64": "x86_64-apple-darwin",
    "darwin_arm64": "aarch64-apple-darwin",
}

_DEFAULT_HASHES = {
    "1.84.0": {
        "x86_64-unknown-linux-gnu": "de2b041a6e62ec2c37c517eb58518f68fde5fc2f076218393ae06145d92a5682",
        "aarch64-unknown-linux-gnu": "282d281cb389bdc2c0671c2a74eeda46e010a158810d2137c3a948ae6c713543",
        "x86_64-apple-darwin": "eafe087277ad8d7473f978d0779b4504d5b8064a781784aebd3e33c2541a13ce",
        "aarch64-apple-darwin": "506dfc14115d2efa96fad9fa542d67027525aa46882a8e1ffb41e891737b689b",
    },
    "1.85.0": {
        "x86_64-unknown-linux-gnu": "be4ba7b777100c851ab268e95f70f405d28d7813ba60a9bdcf4e88c88acf8602",
        "aarch64-unknown-linux-gnu": "0306c30bee00469fbec4b07bb04ea0308c096454354c3dc96a92b729f1c2acd1",
        "x86_64-apple-darwin": "69a36d239e38cc08c6366d1d85071847406645346c6f2d2e0dfaf64b58050d3d",
        "aarch64-apple-darwin": "3ff45cefaf9a002069902acf3a6332113b76b530bb31803fe5cfd30f7ef8ba03",
    },
}

def _rust_tool():
    return "///rust//tools/please_rust"

def _rustc_info():
    rustc_tool = CONFIG.RUST.RUSTC_TOOL
    if rustc_tool.startswith("//") or rustc_tool.startswith(":") or rustc_tool.startswith("///"):
        return {
            "is_label": True,
            "tools": {"RUSTC": [rustc_tool]},
            "arg": '--rustc "$RUSTC"',
        }
    elif rustc_tool:
        return {
            "is_label": False,
            "tools": {},
            "arg": f'--rustc "{rustc_tool}"',
        }
    else:
        return {
            "is_label": False,
            "tools": {},
            "arg": "",
        }

def _cargo_path():
    return ""

def _default_edition():
    return CONFIG.RUST.DEFAULT_EDITION

def rust_toolchain(
    name: str = "toolchain",
    version: str = "1.85.0",
    hashes: dict = None,
    visibility: list = ["PUBLIC"],
):
    """
    Downloads and unpacks a hermetic Rust compiler toolchain and sysroot.

    Args:
      name:        Name of the toolchain target.
      version:     Rust version (e.g. "1.85.0").
      hashes:      Optional dict or string mapping target triple to sha256 checksum.
      visibility:  Visibility list for the rule.
    """
    arch = CONFIG.ARCH
    os_name = CONFIG.OS

    if "_" not in arch and os_name:
        arch_key = f"{os_name}_{arch}"
    else:
        arch_key = arch

    if arch_key not in _TARGET_TRIPLES:
        fail(f"rust_toolchain '{name}': unsupported architecture '{arch_key}'")

    target_triple = _TARGET_TRIPLES[arch_key]

    sha256 = None
    if hashes:
        if len(hashes) == 64:
            sha256 = hashes
        else:
            sha256 = hashes.get(target_triple)
    else:
        sha256 = _DEFAULT_HASHES.get(version, {}).get(target_triple)

    if not sha256:
        fail(f"rust_toolchain '{name}': no sha256 hash found for Rust version '{version}' and target '{target_triple}'")

    tar_name = f"rust-{version}-{target_triple}.tar.gz"
    dl_out = f"_{name}_{tar_name}"
    dl_name = f"_{name}#download"

    remote_file(
        name = dl_name,
        url = f"https://static.rust-lang.org/dist/{tar_name}",
        hashes = [sha256],
        out = dl_out,
    )

    pkg = package_name()
    pkg_prefix = f"{pkg}/" if pkg else ""

    cmd = f"""
mkdir -p "{name}"
tar -xzf "{pkg_prefix}{dl_out}"
cd "rust-{version}-{target_triple}"
./install.sh --components=rustc,rust-std-{target_triple} --prefix="$(pwd)/../{name}/sysroot" --disable-ldconfig
cd ..
cat << 'EOF' > {name}/rustc
#!/bin/bash
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SYSROOT="$DIR/sysroot"
exec "$SYSROOT/bin/rustc" --sysroot "$SYSROOT" "$@"
EOF
chmod +x {name}/rustc
"""

    return build_rule(
        name = name,
        outs = [f"{name}/rustc", f"{name}/sysroot"],
        deps = [f":{dl_name}"],
        cmd = cmd,
        binary = True,
        entry_points = {"rustc": f"{name}/rustc"},
        visibility = visibility,
        labels = ["rust", "rust_toolchain"],
        building_description = f"Assembling Rust toolchain {version} ({target_triple})...",
    )

def rust_library(
    name: str,
    srcs: list = None,
    deps: list = None,
    edition: str = None,
    flags: list = None,
    crate_name: str = None,
    main: str = None,
    visibility: list = None,
    test_only: bool = False,
    labels: list = None,
    env: dict = None,
):
    """
    Compiles a Rust static library (.rlib).
    """
    srcs = srcs or []
    deps = deps or []
    flags = flags or []
    edition = edition or _default_edition()
    crate = crate_name or name

    resolved_main = main
    if not resolved_main:
        for cand in ["src/lib.rs", "lib.rs", "mod.rs", "src/mod.rs"]:
            if cand in srcs and not resolved_main:
                resolved_main = cand
        if not resolved_main and len(srcs) > 0:
            resolved_main = srcs[0]

    out_file = f"lib{crate}.rlib"
    flags_str = " ".join(flags)
    info = _rustc_info()
    rustc_arg = info["arg"]

    tools = {"TOOL": [_rust_tool()]}
    if info["is_label"]:
        tools["RUSTC"] = info["tools"]["RUSTC"]

    env_exports = ""
    if env:
        env_exports = "\n".join([f'export {k}="{v}"' for k, v in env.items()]) + "\n"

    cmd = f"""
    {env_exports}
    TOOL="${{TOOLS_TOOL:-}}"
    if [ -z "$TOOL" ]; then
      TOOL="${{TOOL:-}}"
    fi
    RUSTC="${{TOOLS_RUSTC:-}}"
    $TOOL compile \\
      --crate-name {crate} \\
      --crate-type rlib \\
      --edition {edition} \\
      --out $OUT \\
      --main-src "{resolved_main}" \\
      --version "${CARGO_PKG_VERSION:-}" \\
      --flags "{flags_str}" \\
      {rustc_arg} \\
      ${SRCS:-} ${DEPS:-}
    """

    return build_rule(
        name = name,
        srcs = srcs,
        deps = deps,
        outs = [out_file],
        cmd = cmd,
        needs_transitive_deps = True,
        tools = tools,
        visibility = visibility,
        test_only = test_only,
        labels = labels or ["rust"],
        building_description = f"Compiling Rust library {crate}...",
    )

def rust_bin(
    name: str,
    srcs: list = None,
    deps: list = None,
    edition: str = None,
    flags: list = None,
    crate_name: str = None,
    main: str = None,
    visibility: list = None,
    test_only: bool = False,
    labels: list = None,
    env: dict = None,
):
    """
    Compiles a Rust binary executable.
    """
    srcs = srcs or []
    deps = deps or []
    flags = flags or []
    edition = edition or _default_edition()
    crate = crate_name or name

    resolved_main = main
    if not resolved_main:
        resolved_main = srcs[0] if len(srcs) == 1 else "src/main.rs"
        if resolved_main not in srcs and len(srcs) > 0:
            resolved_main = srcs[0]

    flags_str = " ".join(flags)
    info = _rustc_info()
    rustc_arg = info["arg"]

    tools = {"TOOL": [_rust_tool()]}
    if info["is_label"]:
        tools["RUSTC"] = info["tools"]["RUSTC"]

    env_exports = ""
    if env:
        env_exports = "\n".join([f'export {k}="{v}"' for k, v in env.items()]) + "\n"

    cmd = f"""
    {env_exports}
    TOOL="${{TOOLS_TOOL:-}}"
    if [ -z "$TOOL" ]; then
      TOOL="${{TOOL:-}}"
    fi
    RUSTC="${{TOOLS_RUSTC:-}}"
    $TOOL compile \\
      --crate-name {crate} \\
      --crate-type bin \\
      --edition {edition} \\
      --out $OUT \\
      --main-src "{resolved_main}" \\
      --version "${CARGO_PKG_VERSION:-}" \\
      --flags "{flags_str}" \\
      {rustc_arg} \\
      ${SRCS:-} ${DEPS:-}
    """

    return build_rule(
        name = name,
        srcs = srcs,
        deps = deps,
        outs = [name],
        cmd = cmd,
        binary = True,
        needs_transitive_deps = True,
        tools = tools,
        visibility = visibility,
        test_only = test_only,
        labels = labels or ["rust"],
        building_description = f"Compiling Rust binary {name}...",
    )

def rust_test(
    name: str,
    srcs: list = None,
    deps: list = None,
    edition: str = None,
    flags: list = None,
    crate_name: str = None,
    main: str = None,
    visibility: list = None,
    labels: list = None,
    data: list = None,
    size: str = "medium",
    timeout: int = 0,
    flaky: bool = False,
    env: dict = None,
):
    """
    Compiles and executes a Rust test suite using Please's test runner.
    """
    srcs = srcs or []
    deps = deps or []
    flags = flags or []
    edition = edition or _default_edition()
    crate = crate_name or name

    resolved_main = main
    if not resolved_main:
        for cand in ["src/lib.rs", "lib.rs", "mod.rs", "src/mod.rs"]:
            if cand in srcs and not resolved_main:
                resolved_main = cand
        if not resolved_main and len(srcs) > 0:
            resolved_main = srcs[0]

    flags_str = " ".join(flags)
    info = _rustc_info()
    rustc_arg = info["arg"]

    tools = {"TOOL": [_rust_tool()]}
    if info["is_label"]:
        tools["RUSTC"] = info["tools"]["RUSTC"]

    env_exports = ""
    if env:
        env_exports = "\n".join([f'export {k}="{v}"' for k, v in env.items()]) + "\n"

    cmd = f"""
    {env_exports}
    TOOL="${{TOOLS_TOOL:-}}"
    if [ -z "$TOOL" ]; then
      TOOL="${{TOOL:-}}"
    fi
    RUSTC="${{TOOLS_RUSTC:-}}"
    $TOOL compile \\
      --crate-name {crate} \\
      --crate-type test \\
      --edition {edition} \\
      --out $OUT \\
      --main-src "{resolved_main}" \\
      --version "${CARGO_PKG_VERSION:-}" \\
      --flags "{flags_str}" \\
      {rustc_arg} \\
      ${SRCS:-} ${DEPS:-}
    """

    test_cmd = f'$TOOL test-runner --pkg "{crate}" "$TEST" -- --nocapture'
    if env:
        test_env_exports = " && ".join([f'export {k}="{v}"' for k, v in env.items()])
        test_cmd = f'{test_env_exports} && {test_cmd}'

    return build_rule(
        name = name,
        srcs = srcs,
        deps = deps,
        outs = [name],
        cmd = cmd,
        test_cmd = test_cmd,
        binary = True,
        test = True,
        needs_transitive_deps = True,
        tools = tools,
        test_tools = {
            "TOOL": [_rust_tool()],
        },
        visibility = visibility,
        labels = labels or ["rust"],
        data = data,
        size = size,
        test_timeout = timeout,
        flaky = flaky,
        building_description = f"Compiling Rust test {name}...",
    )

def rust_crate(
    name: str,
    version: str = "",
    sha256: str = "",
    crate_name: str = "",
    features: list = None,
    deps: list = None,
    proc_macro: bool = False,
    meta: bool = False,
    c_srcs: list = None,
    c_hdrs: list = None,
    flags: list = None,
    build_script: bool = False,
    license: str = "",
    repository: str = "",
    visibility: list = ["PUBLIC"],
):
    """
    Downloads and compiles a third-party Rust crate hermetically — no cargo.

    Source is fetched from crates.io once (sha256-verified) and cached by Please.
    Each crate is compiled individually with rustc, using explicitly-declared deps.
    Hash consistency is guaranteed by Please's dep graph, not a shared cargo workspace.

    To get the sha256 for a new crate:
      please_rust hash --crate <name> --version <version>

    Args:
      name:         Crate package name as on crates.io (may use hyphens).
      version:      Exact crate version (e.g. "0.26.11").
      sha256:       SHA-256 hex digest of the .crate tarball. Required.
      crate_name:   Rust identifier (underscores). Defaults to name with hyphens replaced.
      features:     Rust feature flags to enable (e.g. ["derive"]).
      deps:         All Rust-level deps; each must produce an rlib or so.
      proc_macro:   True if this is a proc-macro crate (produces .so instead of .rlib).
      meta:         True for virtual targets with no compiled output.
      c_srcs:       C source files inside the crate (relative to crate root).
                    Compiled directly — avoids needing to run build.rs for grammar crates.
      c_hdrs:       C header directories inside the crate (relative to crate root).
      build_script: Reserved. True if build.rs generates code (not yet implemented).
      license:      Informational only.
      repository:   Informational only.
    """
    features = features or []
    deps = deps or []
    c_srcs = c_srcs or []
    c_hdrs = c_hdrs or []
    vis = visibility or ["PUBLIC"]

    if meta:
        return filegroup(
            name = name,
            deps = deps,
            visibility = vis,
            labels = ["rust", "rust_crate", "meta"],
        )

    if not version:
        fail(f"rust_crate '{name}' requires a version")
    if not sha256:
        fail(f"rust_crate '{name}': sha256 is required.\nRun: please_rust hash --crate {name} --version {version}")

    crate = (crate_name or name).replace("-", "_")
    ext = ".so" if proc_macro else ".rlib"
    out_file = f"lib{crate}{ext}"
    features_str = ",".join(features)

    info = _rustc_info()
    rustc_arg = info["arg"]

    tools = {"TOOL": [_rust_tool()]}
    if info["is_label"]:
        tools["RUSTC"] = info["tools"]["RUSTC"]

    pkg = package_name()
    pkg_prefix = f"{pkg}/" if pkg else ""
    tar_name = f"{name}-{version}.tar"

    # 1. Download
    dl = f"_download_{name}"
    build_rule(
        name = dl,
        outs = [tar_name],
        cmd = f"""
$TOOL download \\
  --crate {name} \\
  --version {version} \\
  --sha256 {sha256} \\
  --out "$OUT"
""",
        tools = {"TOOL": [_rust_tool()]},
        labels = ["rust_download"],
        building_description = f"Downloading {name} {version}...",
    )

    all_deps = [f":{dl}"] + deps

    # 2. C compilation
    native_lib_arg = ""
    if c_srcs:
        cl = f"_c_{name}"
        inc_args = " ".join([f'--include "{name}-{version}/{h}"' for h in c_hdrs])
        src_args = " ".join([f'"{name}-{version}/{s}"' for s in c_srcs])

        build_rule(
            name = cl,
            outs = [f"lib{crate}.a"],
            deps = [f":{dl}"],
            cmd = f"""
tar xf "{pkg_prefix}{tar_name}"
$TOOL compile-c \\
  --out "$OUT" \\
  {inc_args} \\
  {src_args}
""",
            tools = {"TOOL": [_rust_tool()]},
            labels = ["rust_c_compile"],
            building_description = f"Compiling C for {name}...",
        )
        all_deps += [f":{cl}"]
        native_lib_arg = f'--native-lib "{pkg_prefix}lib{crate}.a"'

    # 3. Compile Rust
    features_flag = f'--features "{features_str}"' if features_str else ""
    flags_str = " ".join(flags or [])
    flags_arg = f'--flags "{flags_str}"' if flags_str else ""
    crate_type = "proc-macro" if proc_macro else "rlib"

    cmd = f"""
tar xf "{pkg_prefix}{tar_name}"
export OUT_DIR="${{OUT_DIR:-$(pwd)/{name}-{version}/src/wasm}}"
if [ ! -d "$OUT_DIR" ]; then
  export OUT_DIR="$(pwd)/{name}-{version}"
fi
TOOL="${{TOOLS_TOOL:-}}"
if [ -z "$TOOL" ]; then
  TOOL="${{TOOL:-}}"
fi
RUSTC="${{TOOLS_RUSTC:-}}"
$TOOL compile \\
  --crate-name {crate} \\
  --crate-type {crate_type} \\
  --version {version} \\
  --out "$OUT" \\
  --meta "{name}-{version}/crate_meta.json" \\
  {features_flag} \\
  {flags_arg} \\
  {native_lib_arg} \\
  {rustc_arg} \\
  ${DEPS:-}
"""

    return build_rule(
        name = name,
        outs = [out_file],
        deps = all_deps,
        cmd = cmd,
        needs_transitive_deps = True,
        tools = tools,
        visibility = vis,
        labels = ["rust", "rust_crate"],
        building_description = f"Compiling {name} {version}...",
    )
